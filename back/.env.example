NODE_ENV=development
PORT=3000

# Supabase PostgreSQL connection string.
# Use the pooled connection string for serverless deployments and the direct
# connection string for migrations when needed.
DATABASE_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?schema=public"
DATABASE_CONNECT_ON_BOOT=false

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET_SCHOOL_LOGOS="school-logos"

# Shared curriculum titles used by every academic subject in report cards.
ACADEMIC_BLOCK_1_TITLE="Comunicativa"
ACADEMIC_BLOCK_2_TITLE="Pensamiento Lógico, Creativo y Crítico - Resolución de Problemas"
ACADEMIC_BLOCK_3_TITLE="Científica y Tecnológica - Ambiental y de la Salud"
ACADEMIC_BLOCK_4_TITLE="Ética y Ciudadana - Desarrollo Personal y Espiritual"

JWT_SECRET="replace-with-a-long-random-secret"
